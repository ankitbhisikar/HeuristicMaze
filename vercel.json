{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/auth/(.*)", "dest": "/server.js" },
    { "src": "/signin", "dest": "/index.html?signin=true" },
    { "src": "/login", "dest": "/index.html?signin=true" },
    { "src": "/logout", "dest": "/auth/logout" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
